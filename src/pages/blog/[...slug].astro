---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, getYearMonth, slugify } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { year, month, label } = getYearMonth(post.data.pubDate);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${post.data.title} · 서재`} description={post.data.description} current="blog">
	<article class="prose">
		<div class="post-meta">
			<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
			<a href={`${base}blog/category/${slugify(post.data.category)}/`}>{post.data.category}</a>
			<a href={`${base}blog/archive/${year}/${month}/`}>{label}</a>
		</div>
		<h1>{post.data.title}</h1>
		<p>{post.data.description}</p>
		<div class="chip-row">
			{post.data.tags.map((tag) => (
				<a class="chip" href={`${base}blog/tag/${slugify(tag)}/`}>
					{tag}
				</a>
			))}
		</div>
		<hr style="border: none; border-top: 1px solid var(--line); margin: 1.5rem 0;" />
		<Content />
	</article>
</BaseLayout>
