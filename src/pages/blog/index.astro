---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PostList from '../../components/PostList.astro';
import {
	getCategories,
	getMonthlyArchives,
	getPublishedPosts,
	getTags,
	slugify,
} from '../../lib/blog';

const posts = await getPublishedPosts();
const categories = getCategories(posts);
const tags = getTags(posts);
const archives = getMonthlyArchives(posts);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Blog · 서재" description="블로그 글 목록" current="blog">
	<section class="page-panel">
		<h1 class="section-title">Blog</h1>
		<p class="section-lead">카테고리 · 태그 · 월별로 글을 모아볼 수 있습니다.</p>

		<div class="chip-row">
			{categories.map((category) => (
				<a class="chip" href={`${base}blog/category/${slugify(category)}/`}>
					#{category}
				</a>
			))}
		</div>

		<div class="chip-row">
			{tags.map((tag) => (
				<a class="chip" href={`${base}blog/tag/${slugify(tag)}/`}>
					{tag}
				</a>
			))}
		</div>

		<div class="archive-grid" style="margin: 1.5rem 0 2rem;">
			{archives.map((item) => (
				<a
					class="archive-link"
					href={`${base}blog/archive/${item.year}/${item.month}/`}
				>
					<span>{item.label}</span>
					<span>{item.count}편</span>
				</a>
			))}
		</div>

		<PostList>
			{posts.map((post) => (
				<li>
					<PostCard post={post} />
				</li>
			))}
		</PostList>
	</section>
</BaseLayout>
